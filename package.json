{
  "name": "firequiz-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
